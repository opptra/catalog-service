# Cloud SQL Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=catalog_service
DB_USER=postgres
DB_PASSWORD=your-db-password

# API
API_KEY=your-api-key-here

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-5-image

# Local generate pipeline inputs/outputs (relative to server/)
GENERATE_INPUT_DIR=data/generate-pipeline/v1
GENERATE_OUTPUT_DIR=storage/generated
