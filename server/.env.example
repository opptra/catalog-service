# Cloud SQL Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=catalog_service
DB_USER=postgres
DB_PASSWORD=your-db-password
USER_SERVICE_DB_NAME=user_service

# API
API_KEY=your-api-key-here

# Google Sign-In (same Web client ID as the SPA's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Comma-separated origins allowed to call the API cross-origin (local dev only —
# in production nginx serves client + API from the same origin, so leave empty).
CORS_ORIGINS=http://localhost:5173

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model IDs the generation pipeline uses. Prompt/text models are unchanged when
# you swap the image model — only the image generation path changes.
OPENROUTER_PROMPT_MODEL=openai/gpt-5.4-mini
OPENROUTER_TEXT_MODEL=openai/gpt-5.4-mini

# Image generation model — change this one line to compare providers.
# Each run writes a new folder: output_latest/<gemini|gpt|grok>/<n>/ (never overwrites).
# Known IDs (pick one):
#   google/gemini-3-pro-image              # Gemini (current chat+modalities path)
#   openai/gpt-image-2                     # GPT Image 2 (Images API)
#   x-ai/grok-imagine-image-quality        # Grok Imagine (Images API)
OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image
