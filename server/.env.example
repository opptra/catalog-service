# Cloud SQL Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=catalog_service
DB_USER=postgres
DB_PASSWORD=your-db-password
USER_SERVICE_DB_NAME=user_service

# API
API_KEY=your-api-key-here

# Google Sign-In (same Web client ID as the SPA's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Comma-separated origins allowed to call the API cross-origin (local dev only —
# in production nginx serves client + API from the same origin, so leave empty).
CORS_ORIGINS=http://localhost:5173

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
