# Cloud SQL Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=catalog_service
DB_USER=postgres
DB_PASSWORD=your-db-password
USER_SERVICE_DB_NAME=user_service

# API
API_KEY=your-api-key-here

# Machine callers for @internal_api routes (local / process env — kept flat for easy testing).
# In Secret Manager these live nested under server.SERVICE_CLIENTS; fetch-secrets and
# instance-startup flatten them to SERVICE_CLIENT_<ID> (client-id "catalog-workflows"
# -> SERVICE_CLIENT_CATALOG_WORKFLOWS). Token must match the Workflows cloud secret.
SERVICE_CLIENT_CATALOG_WORKFLOWS=your-shared-token

# Google Sign-In (same Web client ID as the SPA's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Catalog-issued session JWT (httpOnly cookie after Google login). Required.
# Generate a long random string (e.g. openssl rand -hex 32). Provision the same
# key in Secret Manager server.SESSION_JWT_SECRET before deploy.
SESSION_JWT_SECRET=replace-with-a-long-random-secret
SESSION_TTL_HOURS=24
# Optional: force Secure cookie flag. Leave unset to follow the request scheme
# (http → false locally, https / X-Forwarded-Proto → true behind the LB).
# COOKIE_SECURE=

# Comma-separated origins allowed to call the API cross-origin (local dev only —
# in production nginx serves client + API from the same origin, so leave empty).
CORS_ORIGINS=http://localhost:5173

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model IDs the generation pipeline uses. Prompt/text models are unchanged when
# you swap the image model — only the image generation path changes.
OPENROUTER_PROMPT_MODEL=openai/gpt-5.4-mini
OPENROUTER_TEXT_MODEL=openai/gpt-5.4-mini

# Image generation model — change this one line to compare providers.
# Generated images are uploaded to GCS under jobs/{job}/sku_generation_jobs/{sku_generation_job}/images/.
# Known IDs (pick one):
#   google/gemini-3-pro-image              # Gemini (chat + modalities path)
#   openai/gpt-image-2                     # GPT Image 2 (Images API)
OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image

# Google Cloud (GCS + Cloud Workflows). Credentials via ADC —
# GOOGLE_APPLICATION_CREDENTIALS locally, VM service account on GCE.
# Project: do NOT put in Secret Manager. Locally set GOOGLE_CLOUD_PROJECT so
# google.auth.default() can resolve it; on GCE metadata supplies it.
# REGION is required (same key in Secret Manager server.REGION for deploy + app).
# Flatfile uploads: browser PUT/DELETE to GCS need bucket CORS allowing the app
# origin for PUT, DELETE, OPTIONS (and Content-Type). Bucket catalog-service is
# configured for http://localhost:5173 and https://studio.opptra.com.
# Product images: products/{sku_id}/assets/images/
# Flatfile templates: jobs/{job_external_id}/input/template/
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
# Service account email for V4 signed URL SignBlob (…@….iam.gserviceaccount.com).
# Not a personal user email. Local user ADC / VM SA need roles/iam.serviceAccountTokenCreator
# on this SA. Same value local + prod if you use one shared signer SA.
GCS_SIGNER_SERVICE_ACCOUNT_EMAIL=
REGION=asia-south1

# Dropbox — listing fill uploads generated images here and writes shared HTTPS
# URLs into Amazon IMAGE columns (GCS signed URLs expire; Amazon needs durable links).
# One-time OAuth (token_access_type=offline) → store refresh token. Leave any of
# these empty to disable the Dropbox client. Access tokens are fetched in-memory only.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_PATH=/catalog-service/listing-images
